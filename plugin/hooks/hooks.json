{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*vps[-_]agent.*__(exec|job_start|session_send_keys|user_delete|nginx_remove)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.sh\""
          }
        ]
      }
    ]
  }
}
